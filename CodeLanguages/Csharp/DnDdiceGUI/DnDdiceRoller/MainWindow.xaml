<Window x:Class="DnDDiceRoller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="D&amp;D Dice Roller" Height="400" Width="400"
        Background="#1E1E1E">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dice selection -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Select Dice:" Foreground="White" FontSize="14" Width="100"/>
            <ComboBox x:Name="cmbDiceType" Width="100" FontSize="14">
                <ComboBoxItem>d4</ComboBoxItem>
                <ComboBoxItem>d6</ComboBoxItem>
                <ComboBoxItem>d8</ComboBoxItem>
                <ComboBoxItem>d10</ComboBoxItem>
                <ComboBoxItem>d12</ComboBoxItem>
                <ComboBoxItem>d20</ComboBoxItem>
                <ComboBoxItem>d100</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- Number of dice -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Grid.Row="1">
            <Label Content="Dice Count:" Foreground="White" FontSize="14" Width="100"/>
            <TextBox x:Name="txtDiceCount" Width="60" Text="1" FontSize="14" />
        </StackPanel>

        <!-- Results area -->
        <TextBox x:Name="txtResults" 
                 Grid.Row="2"
                 FontFamily="Consolas"
                 FontSize="14"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 Background="#252526" Foreground="White"/>

        <!-- Roll button & total -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button x:Name="btnRoll" Content="Roll Dice" Width="100" Height="30" Click="btnRoll_Click"/>
            <Label x:Name="lblTotal" Content="Total: 0" Foreground="White" FontSize="16" Margin="20,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
